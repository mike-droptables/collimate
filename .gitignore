.collimate/*
# Server data dirs under api/: dev_server.sh's default data dir is api/
# itself, and a relative --data-dir resolves under api/ at any depth
# (--data-dir a/b is api/a/b). Each holds its .collimate/ and its default
# channel location Channels/.
api/**/.collimate/
api/**/Channels/
