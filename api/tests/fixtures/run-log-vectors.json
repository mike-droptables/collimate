{
  "description": "Golden vectors for the run-log line format: one run_events row (event_type, payload text, created_at) and the line it renders as, or null when the row is dropped. Two implementations read this file and must produce every line exactly: api/process_manager/log_format.py (api/tests/test_pytest_log_format.py) and frontend/src/lib/runLogFormat.ts (frontend/src/lib/runLogFormat.test.ts). Stored timestamps are UTC; the lines are rendered with the local time zone set to `timezone`, a fixed UTC+05:30, so 12:01:03 UTC reads 17:31:03.",
  "timezone": "Asia/Kolkata",
  "cases": [
    {"name": "stdout is OUT with a local-time stamp", "event_type": "stdout", "payload": "Building\n", "created_at": "2026-06-29 12:01:03", "line": "[17:31:03] OUT    Building"},
    {"name": "bare stderr is STDERR, subprocess narration and not an error", "event_type": "stderr", "payload": "Collecting requests…\n", "created_at": "2026-06-29 12:01:03", "line": "[17:31:03] STDERR Collecting requests…"},
    {"name": "gen.log INFO stderr re-tags to LOG and strips the frame", "event_type": "stderr", "payload": "[INFO] cloning repo\n", "created_at": "2026-06-29 12:01:03", "line": "[17:31:03] LOG    cloning repo"},
    {"name": "WARNING stderr is WARN", "event_type": "stderr", "payload": "[WARNING] slow", "created_at": "2026-06-29 12:01:03", "line": "[17:31:03] WARN   slow"},
    {"name": "ERROR stderr is ERR", "event_type": "stderr", "payload": "[ERROR] boom", "created_at": "2026-06-29 12:01:03", "line": "[17:31:03] ERR    boom"},
    {"name": "CRITICAL stderr is ERR", "event_type": "stderr", "payload": "[CRITICAL] dead", "created_at": "2026-06-29 12:01:03", "line": "[17:31:03] ERR    dead"},
    {"name": "a non-level bracket prefix stays STDERR, unstripped", "event_type": "stderr", "payload": "[git-clone] starting", "created_at": "2026-06-29 12:01:03", "line": "[17:31:03] STDERR [git-clone] starting"},
    {"name": "phase with a message", "event_type": "phase", "payload": "{\"phase\": \"spinning_up\", \"message\": \"pulling image\"}", "created_at": "2026-06-29 12:01:03", "line": "[17:31:03] PHASE  spinning_up — pulling image"},
    {"name": "phase without a message", "event_type": "phase", "payload": "{\"phase\": \"running\"}", "created_at": "2026-06-29 12:01:03", "line": "[17:31:03] PHASE  running"},
    {"name": "log (host push_log) renders as LOG", "event_type": "log", "payload": "cloning repo\n", "created_at": "2026-06-29 12:01:03", "line": "[17:31:03] LOG    cloning repo"},
    {"name": "the status event type is gone (unified into phase)", "event_type": "status", "payload": "{\"message\": \"x\"}", "created_at": "2026-06-29 12:01:03", "line": null},
    {"name": "progress", "event_type": "progress", "payload": "{\"op\": \"progress\", \"current\": 3, \"total\": 10}", "created_at": "2026-06-29 12:01:03", "line": "[17:31:03] PROG   3/10"},
    {"name": "a JSON null progress count is missing", "event_type": "progress", "payload": "{\"current\": null, \"total\": 5}", "created_at": "2026-06-29 12:01:03", "line": "[17:31:03] PROG   ?/5"},
    {"name": "an explicit null success is falsy", "event_type": "finish", "payload": "{\"success\": null}", "created_at": "2026-06-29 12:01:03", "line": "[17:31:03] DONE   failed"},
    {"name": "a JSON null egress port is missing", "event_type": "egress_denied", "payload": "{\"host\": \"h\", \"port\": null, \"method\": \"GET\"}", "created_at": "2026-06-29 12:01:03", "line": "[17:31:03] EGRESS blocked: GET h"},
    {"name": "egress with a port", "event_type": "egress_denied", "payload": "{\"host\": \"pypi.org\", \"port\": 443, \"method\": \"CONNECT\"}", "created_at": "2026-06-29 12:01:03", "line": "[17:31:03] EGRESS blocked: CONNECT pypi.org:443"},
    {"name": "finish success", "event_type": "finish", "payload": "{\"success\": true}", "created_at": "2026-06-29 12:01:03", "line": "[17:31:03] DONE   ok"},
    {"name": "finish failure with its error", "event_type": "finish", "payload": "{\"success\": false, \"error_message\": \"rc=128\"}", "created_at": "2026-06-29 12:01:03", "line": "[17:31:03] DONE   failed: rc=128"},
    {"name": "commit is the cell name alone", "event_type": "commit", "payload": "{\"name\": \"Git Clone\", \"sequence_num\": 1, \"file_count\": 142}", "created_at": "2026-06-29 12:01:03", "line": "[17:31:03] COMMIT Git Clone"},
    {"name": "a nameless commit is the tag and the pad", "event_type": "commit", "payload": "{\"sequence_num\": 2}", "created_at": "2026-06-29 12:01:03", "line": "[17:31:03] COMMIT "},
    {"name": "no_output is machine-readable only and dropped", "event_type": "no_output", "payload": "{\"message\": \"Run completed without committing any output\"}", "created_at": "2026-06-29 12:01:03", "line": null},
    {"name": "stop", "event_type": "stop", "payload": "{\"stop_type\": \"force_stopped\"}", "created_at": "2026-06-29 12:01:03", "line": "[17:31:03] STOP   force_stopped"},
    {"name": "timeout", "event_type": "timeout", "payload": "Exceeded 600s", "created_at": "2026-06-29 12:01:03", "line": "[17:31:03] TIMOUT Exceeded 600s"},
    {"name": "ipc_error", "event_type": "ipc_error", "payload": "oversize", "created_at": "2026-06-29 12:01:03", "line": "[17:31:03] IPCERR oversize"},
    {"name": "run_started names the runner", "event_type": "run_started", "payload": "{\"runner\": \"synthetic-runner\"}", "created_at": "2026-06-29 12:01:03", "line": "[17:31:03] RUN    started · synthetic-runner"},
    {"name": "run_finished names the status and the runner", "event_type": "run_finished", "payload": "{\"status\": \"Completed\", \"runner\": \"synthetic-runner\"}", "created_at": "2026-06-29 12:01:03", "line": "[17:31:03] RUN    finished · Completed · synthetic-runner"},
    {"name": "run_finished with a short runner tag", "event_type": "run_finished", "payload": "{\"status\": \"Failed\", \"runner\": \"r\"}", "created_at": "2026-06-29 12:01:03", "line": "[17:31:03] RUN    finished · Failed · r"},
    {"name": "a missing runner segment (reload re-attach) drops out", "event_type": "run_finished", "payload": "{\"status\": \"Failed\"}", "created_at": "2026-06-29 12:01:03", "line": "[17:31:03] RUN    finished · Failed"},
    {"name": "run_started with no runner", "event_type": "run_started", "payload": "{}", "created_at": "2026-06-29 12:01:03", "line": "[17:31:03] RUN    started"},
    {"name": "the allow-list drops stream_event", "event_type": "stream_event", "payload": "{}", "created_at": "2026-06-29 12:01:03", "line": null},
    {"name": "the allow-list drops chat_poll", "event_type": "chat_poll", "payload": "{}", "created_at": "2026-06-29 12:01:03", "line": null},
    {"name": "the allow-list drops port_bound", "event_type": "port_bound", "payload": "{}", "created_at": "2026-06-29 12:01:03", "line": null},
    {"name": "the allow-list drops dag_commit", "event_type": "dag_commit", "payload": "{}", "created_at": "2026-06-29 12:01:03", "line": null},
    {"name": "the allow-list drops an unknown op", "event_type": "unknown_op", "payload": "{}", "created_at": "2026-06-29 12:01:03", "line": null},
    {"name": "the allow-list drops memory", "event_type": "memory", "payload": "{}", "created_at": "2026-06-29 12:01:03", "line": null},
    {"name": "an ISO timestamp (client-fabricated bookends) converts the same way", "event_type": "stdout", "payload": "hi", "created_at": "2026-06-29T12:01:03.123Z", "line": "[17:31:03] OUT    hi"},
    {"name": "a null timestamp omits the prefix", "event_type": "stdout", "payload": "hi", "created_at": null, "line": "OUT    hi"},
    {"name": "an empty timestamp omits the prefix", "event_type": "stdout", "payload": "hi", "created_at": "", "line": "OUT    hi"},
    {"name": "an unparseable timestamp keeps its raw time slice", "event_type": "stdout", "payload": "hi", "created_at": "2026-06-29 xx:yy:zz", "line": "[xx:yy:zz] OUT    hi"},
    {"name": "a null payload is empty text", "event_type": "stdout", "payload": null, "created_at": "2026-06-29 12:01:03", "line": "[17:31:03] OUT    "},
    {"name": "a malformed JSON payload is empty text, not an error", "event_type": "phase", "payload": "not json", "created_at": "2026-06-29 12:01:03", "line": "[17:31:03] PHASE  "}
  ]
}
