name: Cline
description: Cline in its own container, on the Annotation surface. Provider key, or your ChatGPT subscription
tags:
- agent
- cline
prompt: ''
settings:
  agent-config.set_yaml:
    surface: annotation
    session: interactive
    backend: cline
    system_prompt: ''
    mcp: 'off'
    approvals: auto
    selected_file_first: false
folders: []
accounts: {}
permissions:
  docker: full
  internet: full
  commands: allow
packages: {}
