name: Clone / Update
description: Clone the repository named in the prompt into a folder of this cell, or merge the remote's new commits into that folder, keeping your edits
tags:
- git
prompt: ''
settings:
  settings.set_yaml:
    action: sync
    folder: ''
    branch: ''
    commit_message: ''
    push_branch: ''
folders: []
accounts: {}
permissions:
  docker: none
  internet: full
packages: {}
