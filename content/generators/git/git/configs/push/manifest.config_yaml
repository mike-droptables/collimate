name: Push
description: Push the folder's edits to the repository named in the prompt as one commit on the recorded commit; never force-pushes
tags:
- git
prompt: ''
settings:
  settings.set_yaml:
    action: push
    folder: ''
    branch: ''
    commit_message: ''
    push_branch: ''
folders: []
accounts: {}
permissions:
  docker: none
  internet: full
packages: {}
