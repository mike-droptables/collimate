id: git
name: Git
version: 2.0.0
summary: 'Plain git on this machine (git 2.31 or later, internet: full) for a repository kept in a folder of this
  cell or its root with its own .git, so every git command works on it in later runs too: Clone clones the
  Repository (or makes files already in the folder a checkout of a Base commit), Update pulls the remote''s new
  commits into the branch with uncommitted changes stashed and a conflict leaving git''s markers in the files, and
  Push commits uncommitted changes when a Commit message is set and pushes the branch, never forcing. Public HTTPS
  repositories need no account, while private ones, SSH and every push need the Git account (a Key manager GitHub,
  GitLab or Git server entry, which also holds the commit author).'
prompt_label: Repository
prompt_type: text
prompt_intent: 'Its address (https://host/path, ssh://user@host/path or user@host:path), or owner/name on the server
  of the Git account set below (a GitHub or GitLab entry)'
prompt_required: false
prompt_show_if:
  action: clone
entrypoint: git.py
# git and its network run on this machine; the docker: limited runner image has no git.
runs_on: local-machine
# Clone, Update and Push write the cell's .git: while another run holds the
# cell's repositories, a Git run is refused instead of starting read-only.
exclusive_repositories: true
# The runtime mirrors the workspace and the cell for the whole run, so the
# files git checks out, merges or deletes reach the cell, and edits made in
# the Files tab while it runs reach git.
live_files_mode: auto
main_config: settings.set_yaml
draft_files:
- settings.set_yaml
configs:
- id: clone
  name: Clone
  path: configs/clone/manifest.config_yaml
- id: update
  name: Update
  path: configs/update/manifest.config_yaml
- id: push
  name: Push
  path: configs/push/manifest.config_yaml
required_files: []
account_requirements:
  git:
    label: Git account
    kind: git
    capabilities: [git]
    required: false
