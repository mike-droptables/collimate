name: Terminal
description: A long-running shell in its own container — it keeps running until you stop it
tags:
- terminal
prompt: ''
settings:
  settings.set_yaml:
    mode: terminal
    image: ''
    command: ''
    serve_command: ''
    serve_port: 0
    expose_port: 8080
    startup_commands: ''
    mount_mode: rw
    sudo: false
    start_claude_code: true
folders:
- build
accounts: {}
permissions:
  docker: full
  internet: full
packages: {}
