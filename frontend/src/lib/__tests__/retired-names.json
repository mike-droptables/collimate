    {
      "id": "P5-renderer-hosts",
      "about": "Phase 4 P5: the sibling messages before their qualified rename (a leftover is a renderer that hangs on its 10 s timeout in exactly one host), the local-edit notice every primary edit replaced with an immediate document snapshot, the editor's autosave debounce, and the draft writer sibling writes replaced with conditional file mutations.",
      "files": "app-and-sandbox",
      "names": [
        "SIBLING_REQUEST",
        "SIBLING_RESULT",
        "LOCAL_EDIT",
        "noteLocalEdit",
        "AUTOSAVE_DEBOUNCE",
        "saveDraft"
      ],
      "spares": [
