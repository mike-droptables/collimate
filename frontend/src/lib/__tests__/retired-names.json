        "SIBLING_WRITE",
        "SIBLING_READ_RESULT",
        "SIBLING_WRITE_RESULT",
        "saveSnapshot",
        "saveSiblingFile"
      ]
    },
    {
      "id": "SDK-10",
      "about": "Phase 5 (D10): the authoring contract's one rename break, as the app spells it: gen's update, ui_file, ui_files, terminal and environment_exec under their family names, status deleted, the six session verbs under gen.session (in the generators the app's tests embed); the renderer api's onChange command, its Changed subscriptions, its two CSS names and its preview members, the mirror URL helper; the SDK host plumbing's public module paths, now collimate._host.<module>.",
      "files": "app-code",
      "word_start": true,
      "names": [
        "onSurfaceChanged",
        "onFilesChanged",
        "injectStyle",
        "loadCSS",
        "prepareRendererDependencies",
        "mirrorURL",
        "environment_exec"
      ],
      "patterns": [
        "\\bcompileRenderer\\b",
        "\\b(?:gen|native)\\.update\\b(?!_)",
        "\\b(?:gen|native)\\.ui_files?\\b",
        "\\bgen\\.terminal\\b(?!_)",
        "\\b(?:gen|native)\\.status\\b",
        "\\bgen\\.(?:chat_busy|emit_stream_event|interrupt_turn|pop_config_request|request_finish|submit_turn)\\b",
        "\\bapi\\??\\.onChange\\b",
        "\\bcollimate\\.(?:channel_events|ipc|renderer_bundle|module_mirror|module_bump|esm_lexer|packaging|verification|package_hash|_verifier_engine)\\b",
        "\\bfrom collimate import [^\\n#]*\\b(?:channel_events|ipc|renderer_bundle|module_mirror|module_bump|esm_lexer|packaging|verification|package_hash|_verifier_engine)\\b",
        "\\bcollimate\\._host\\.[A-Z]",
        "\\bfrom collimate\\._host import [A-Z]"
      ],
      "matches": [
        "compileRenderer(files, entry)",
        "await gen.update()",
        "gen.ui_file(path, text)",
        "gen.ui_files()",
        "gen.terminal(cid, argv)",
        "gen.status('pulling')",
        "gen.request_finish()",
        "api.onChange(body)",
        "from collimate.ipc import OPS",
        "from collimate import channel_events",
        "collimate._host.HostBridge",
        "from collimate._host import HostBridge"
      ],
      "spares": [
        "compileRendererFiles",
        "compileRendererPackage",
        "api.preview.compile(files, entry)",
        "preparePreviewDependencies",
        "await gen.commit()",
        "gen.update_file(path, text)",
        "gen.update_ui_file(path, text)",
        "gen.list_ui_files()",
        "gen.start_terminal(cid, argv)",
        "gen.terminal_status(tid)",
        "gen.exec_environment(env, argv)",
        "res.status",
        "gen.session.request_finish()",
        "api.reportChange(body)",
        "onSurfaceChange",
        "onFilesChange",
        "injectCss",
        "loadCss",
        "mirrorUrl(url, base)",
        "from collimate._host.ipc import OPS",
        "from collimate._host import channel_events",
        "from collimate._host.bridge import HostBridge",
        "process_manager/ipc.py",
        "collimate:files-changed-broadcast"
      ]
    }
