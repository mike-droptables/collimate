        "useGdriveAuthStore",
        "refresh_default_bundles",
        "/api/backup",
        "/api/fs/",
        "backupTransfer",
        "localFsTransfer",
        "gdriveTransfer"
      ],
      "spares": [
        "collimate .collrun .collkeep collection",
        "drive the app"
      ]
    },
    {
      "id": "GN-02",
      "about": "The package paths and definition files of the three agent packages the one Agent generator replaced, never the runtime's private log folders under _agent/. Matched ignoring case.",
      "files": "app",
      "ignore_case": true,
      "patterns": [
        "(?<![_\\w])agent\\/todo\\b",
        "\\btodo\\.generator\\b",
        "(?<![_\\w])agent\\/chat\\b",
        "\\bchat\\.generator\\b",
        "(?<![_\\w])agent\\/terminal\\b",
        "\\bterminal\\.generator\\b"
      ],
      "matches": [
        "generators/agent/todo/x.py",
        "generators/agent/chat/x.py",
        "generators/agent/terminal/x.py",
        "x todo.generator y",
        "x chat.generator y",
        "x terminal.generator y"
      ],
      "spares": [
        "_agent/terminal/transcript.json",
        "generators/agent/agent/agent.generator",
        "builtin/live/terminal/main.tsx"
      ]
    },
    {
      "id": "capabilities-stack",
      "about": "The Capabilities stack replaced the Generators and Renderers stacks: their pills, the in-cell Manage tab and its runner list, the per-kind add dialog and route client, the special-stack toggle, the index-addressed front-cell helpers and the in-cell handler build run. Each name starts a word.",
      "files": "app",
      "word_start": true,
      "names": [
        "SpecialPill",
