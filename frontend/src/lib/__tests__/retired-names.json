{
  "about": "Retired names on the app side of the repo: each scan's files may not name any of them, not even to assert their absence. src/lib/__tests__/retiredSurfaces.test.ts reads this file, the one file every scan skips. `matches` are strings a scan must hit and `spares` its live neighbours it must not. Historical plan records (docs/plan*) and scratch (tmp/) are outside every scan.",
  "file_sets": {
    "app": {
      "about": "The app, its desktop shell, its agent notes and the README.",
      "roots": [
        "frontend/src",
        "api",
        "desktop/src",
        "docs/ai_tools",
        "README.md"
      ]
    },
    "app-and-frontend-tests": {
      "about": "The app set, plus the frontend's Playwright tests and its vitest config, where retired fixtures lived.",
      "roots": [
        "frontend/src",
        "api",
        "desktop/src",
        "docs/ai_tools",
        "README.md",
        "frontend/tests",
        "frontend/vitest.config.ts"
      ]
    },
    "app-and-sandbox": {
      "about": "The app set, plus the sandbox shell and the other files the frontend serves as they are.",
      "roots": [
        "frontend/src",
        "api",
        "desktop/src",
        "docs/ai_tools",
        "README.md",
        "frontend/public"
      ]
    },
    "app-code": {
      "about": "The app's code, its desktop shell, its frontend tests and the sandbox shell (not the vendored third-party files beside it), without its agent notes: docs/ai_tools keeps the historical names, and the rename note spells them.",
      "roots": [
        "frontend/src",
        "frontend/public/sandbox.html",
        "frontend/index.html",
        "frontend/tests",
        "frontend/vitest.config.ts",
        "api",
        "desktop/src",
        "README.md"
      ]
    }
  },
  "skipped": [
    "^api/static/",
    "^api/\\.venv/",
    "(?:^|/)__pycache__/",
    "(?:^|/)node_modules/",
    "^docs/plan",
    "^tmp/"
  ],
  "text": "\\.(?:ts|tsx|js|mjs|cjs|css|html|json|md|py|toml|ya?ml|txt|sh|ini|cfg)$",
  "scans": [
    {
      "id": "TR-14",
      "about": "The transfer plan's exit grep: the local browse, backup, Drive and archive surfaces. Matched ignoring case.",
      "files": "app",
      "ignore_case": true,
      "names": [
        "gdrive",
        "colllibrary",
        "collcells",
        "collchannel",
        "collsettings",
        "collgen",
        "collren",
        "LocalFolderView",
        "BackupFolderView",
        "DriveFolderView",
        "DriveBackupView",
