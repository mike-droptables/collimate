        ".css",
        ".handler",
        ".html",
        ".js",
        ".json",
        ".jsx",
        ".md",
        ".mjs",
        ".py",
        ".renderer",
        ".ts",
        ".tsx"
      ]
    },
    "repo": {
      "about": "Every tracked or new file of the SDK member and the first-party trees beside it, tests, workflows and the README included, but scratch. The module snapshot's index and LICENSES files are scanned; its third-party bodies are git-ignored (module-snapshot/modules/<sha256>, stored on the orphan branch module-snapshot), so never listed.",
      "roots": [
        "sdk",
        "content",
        "builtins",
        "module-snapshot"
      ],
      "exclude": [
        "sdk/tmp/"
      ]
    }
  },
